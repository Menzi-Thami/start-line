{
  "name": "start-line-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:security": "node --test ../scripts/picomatch-security.test.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "gen:api": "npx -y openapi-typescript@7 http://localhost:5122/openapi/v1.json -o src/lib/api-schema.ts",
    "e2e": "playwright test",
    "e2e:mobile": "playwright test --config playwright.mobile.config.ts",
    "e2e:connections": "playwright test --config playwright.connections.config.ts"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.30.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "fflate": "^0.8.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "jsdom": "^31.0.1",
    "msw": "^2.15.0",
    "oxlint": "^1.94.0",
    "picomatch": "file:vendor/picomatch",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "picomatch": "$picomatch"
  },
  "engines": {
    "node": ">=22"
  }
}
